{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "good-bye-bad-halloween",
  "compatibility_date": "2026-10-26",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  },
  "routes": [
    {"pattern": "game.chozo.net/good-bye-bad-halloween", "zone_name": "chozo.net"},
    {"pattern": "game.chozo.net/good-bye-bad-halloween/*", "zone_name": "chozo.net"}
  ]
}
